{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r --if-present test",
    "check:packages": "tsx scripts/check-packages.ts",
    "check:public": "tsx scripts/check-public.ts",
    "check:isolated": "tsx scripts/check-isolated.ts",
    "check": "corepack pnpm check:packages && corepack pnpm check:public && corepack pnpm lint && corepack pnpm format:check && corepack pnpm typecheck && corepack pnpm test"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typebox": "1.3.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
